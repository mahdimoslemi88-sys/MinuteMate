<Window x:Class="MinuteMate.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:v="clr-namespace:MinuteMate.App.Views"
        xmlns:vm="clr-namespace:MinuteMate.App.ViewModels"
        mc:Ignorable="d"
        Title="تنظیمات MinuteMate"
        Width="720"
        Height="720"
        MinWidth="600"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        FontFamily="{DynamicResource AppFontFamily}"
        Background="{DynamicResource AppBackgroundBrush}"
        UseLayoutRounding="True">

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="تنظیمات"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="این مقادیر در %LOCALAPPDATA%\MinuteMate\settings.json ذخیره می‌شوند و بر اجرای بعدی هم اثر دارند."
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </StackPanel>

        <TabControl Grid.Row="1" Margin="0,18,0,0" TabStripPlacement="Top">
            <!-- Tab 1: General Settings -->
            <TabItem Header="تنظیمات عمومی">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="موتور" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Right" />

                                <TextBlock Text="مسیر پایتون" Style="{StaticResource InputLabelStyle}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding PythonPath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             FlowDirection="LeftToRight" />
                                    <Button Grid.Column="1"
                                            Content="انتخاب"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowsePythonCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="فایل اجرایی موتور (اختیاری؛ خالی = جست‌وجوی خودکار)"
                                           Style="{StaticResource InputLabelStyle}"
                                           Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding EngineExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             FlowDirection="LeftToRight" />
                                    <Button Grid.Column="1"
                                            Content="انتخاب"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseEngineCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>

                                <TextBlock Text="پوشهٔ مدل‌ها (خالی = models/ کنار پروژه یا متغیر محیطی)"
                                           Style="{StaticResource InputLabelStyle}"
                                           Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ModelsDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             FlowDirection="LeftToRight" />
                                    <Button Grid.Column="1"
                                            Content="انتخاب"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseModelsCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="داده و خروجی" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Right" />

                                <TextBlock Text="پوشهٔ جلسه‌ها"
                                           Style="{StaticResource InputLabelStyle}"
                                           Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SessionsRoot, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             FlowDirection="LeftToRight" />
                                    <Button Grid.Column="1"
                                            Content="انتخاب"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseSessionsCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Text="خالی = &lt;پوشهٔ داده>\sessions"
                                           Style="{StaticResource MutedTextStyle}"
                                           FontSize="11"
                                           Margin="0,4,0,0" />

                                <TextBlock Text="پوشهٔ خروجی قدیمی (حالت مسطح)"
                                           Style="{StaticResource InputLabelStyle}"
                                           Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             FlowDirection="LeftToRight" />
                                    <Button Grid.Column="1"
                                            Content="انتخاب"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding BrowseOutputCommand}"
                                            Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="پیش‌فرض‌های اجرا" Style="{StaticResource SectionTitleStyle}" HorizontalAlignment="Right" />

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="تعداد گویندگان" Style="{StaticResource InputLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding SpeakerCounts}"
                                                  SelectedItem="{Binding NumSpeakers}"
                                                  Style="{StaticResource FormComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                        <TextBlock Text="دستگاه" Style="{StaticResource InputLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding Devices}"
                                                  SelectedItem="{Binding Device}"
                                                  Style="{StaticResource FormComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="6,0,6,0">
                                        <TextBlock Text="نوع محاسبه" Style="{StaticResource InputLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding ComputeTypes}"
                                                  SelectedItem="{Binding ComputeType}"
                                                  Style="{StaticResource FormComboBoxStyle}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="12,0,0,0">
                                        <TextBlock Text="مدل رونویسی" Style="{StaticResource InputLabelStyle}" />
                                        <ComboBox ItemsSource="{Binding AsrModels}"
                                                  SelectedItem="{Binding SelectedAsrModel}"
                                                  Style="{StaticResource FormComboBoxStyle}" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="تولید صورت‌جلسه با هوش مصنوعی (به‌صورت پیش‌فرض)"
                                          IsChecked="{Binding EnableMinutes}"
                                          Margin="0,18,0,0"
                                          HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding ValidationMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibility}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Providers & Models -->
            <TabItem Header="پرووایدرها و مدل‌ها">
                <v:ProviderSettingsView DataContext="{Binding ProviderSettings}" />
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Button Content="ذخیره"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"
                    HorizontalAlignment="Left" />
            <Button Content="انصراف"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="Cancel_Click"
                    HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Window>
