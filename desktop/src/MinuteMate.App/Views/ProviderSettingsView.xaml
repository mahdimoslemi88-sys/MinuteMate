<UserControl x:Class="MinuteMate.App.Views.ProviderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MinuteMate.App.ViewModels"
             xmlns:conv="clr-namespace:MinuteMate.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProviderSettingsViewModel, IsDesignTimeCreatable=False}"
             FlowDirection="RightToLeft"
             Background="{DynamicResource AppBackgroundBrush}">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="مدل‌ها و پرووایدرها"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBlock Text="مدل‌های لوکال و پرووایدرهای API را اینجا مدیریت کنید."
                       Style="{StaticResource MutedTextStyle}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="پرووایدرهای API"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="افزودن پرووایدر"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddProviderCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Providers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Margin="0,8,0,0"
                                            Background="{DynamicResource FieldBackgroundBrush}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,10,0">
                                                <Button Content="↑"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding MoveUpCommand}"
                                                        Padding="8,1"
                                                        FontSize="10"
                                                        ToolTip="اولویت بالاتر" />
                                                <Button Content="↓"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Command="{Binding MoveDownCommand}"
                                                        Padding="8,1"
                                                        FontSize="10"
                                                        Margin="0,4,0,0"
                                                        ToolTip="اولویت پایین‌تر" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">

                                                <!-- Read-only header -->
                                                <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource AppBackgroundBrush}"
                                                                CornerRadius="6"
                                                                Padding="8,2"
                                                                Margin="10,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Type}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Border>
                                                        <TextBlock Text="غیرفعال"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource DangerBrush}"
                                                                   Margin="10,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Button Content="ویرایش"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding EditCommand}"
                                                                Padding="12,4"
                                                                Margin="0,0,6,0" />
                                                        <Button Content="حذف"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding DeleteCommand}"
                                                                Padding="12,4"
                                                                Foreground="{DynamicResource DangerBrush}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Edit form -->
                                                <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="نام:"
                                                                   Style="{StaticResource InputLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBoxStyle}" />
                                                        <CheckBox Grid.Column="2"
                                                                  Content="فعال"
                                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                                  VerticalAlignment="Center"
                                                                  Margin="10,0,0,0" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="نوع:"
                                                                   Style="{StaticResource InputLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1"
                                                                  ItemsSource="{Binding DataContext.ProviderTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                                  Style="{StaticResource FormComboBoxStyle}" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Base URL:"
                                                                   Style="{StaticResource InputLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBoxStyle}"
                                                                 FlowDirection="LeftToRight" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="API Key:"
                                                                   Style="{StaticResource InputLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <PasswordBox Grid.Column="1"
                                                                     Style="{StaticResource FormPasswordBoxStyle}"
                                                                     FlowDirection="LeftToRight"
                                                                     PasswordChanged="ApiKeyBox_PasswordChanged"
                                                                     Loaded="ApiKeyBox_Loaded" />
                                                    </Grid>

                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Model ID:"
                                                                   Style="{StaticResource InputLabelStyle}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource FormTextBoxStyle}"
                                                                 FlowDirection="LeftToRight" />
                                                    </Grid>

                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                        <Button Content="ذخیره"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                Command="{Binding SaveCommand}"
                                                                Padding="16,6"
                                                                Margin="0,0,8,0" />
                                                        <Button Content="انصراف"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Command="{Binding CancelCommand}"
                                                                Padding="16,6" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="مدل‌های لوکال"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Button Content="افزودن مدل لوکال"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddLocalModelCommand}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LocalModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}"
                                            Margin="0,8,0,0"
                                            Background="{DynamicResource FieldBackgroundBrush}">
                                        <StackPanel>

                                            <Grid Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="{Binding ModelPath}"
                                                               Style="{StaticResource MutedTextStyle}"
                                                               FontSize="11"
                                                               FlowDirection="LeftToRight"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Content="ویرایش"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding EditCommand}"
                                                            Padding="12,4"
                                                            Margin="0,0,6,0" />
                                                    <Button Content="حذف"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DeleteCommand}"
                                                            Padding="12,4"
                                                            Foreground="{DynamicResource DangerBrush}" />
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="نام:"
                                                               Style="{StaticResource InputLabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormTextBoxStyle}" />
                                                    <CheckBox Grid.Column="2"
                                                              Content="فعال"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center"
                                                              Margin="10,0,0,0" />
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="مسیر مدل:"
                                                               Style="{StaticResource InputLabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormTextBoxStyle}"
                                                             FlowDirection="LeftToRight" />
                                                    <Button Grid.Column="2"
                                                            Content="انتخاب"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding BrowseModelPathCommand}"
                                                            Padding="10,4"
                                                            Margin="8,0,0,0" />
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Model ID:"
                                                               Style="{StaticResource InputLabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="1"
                                                             Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                                                             Style="{StaticResource FormTextBoxStyle}"
                                                             FlowDirection="LeftToRight" />
                                                </Grid>

                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="دستگاه:"
                                                               Style="{StaticResource InputLabelStyle}"
                                                               VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1"
                                                              ItemsSource="{Binding DataContext.Devices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding Device, Mode=TwoWay}"
                                                              Style="{StaticResource FormComboBoxStyle}" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="محاسبه:"
                                                               Style="{StaticResource InputLabelStyle}"
                                                               VerticalAlignment="Center"
                                                               Margin="10,0,0,0" />
                                                    <ComboBox Grid.Column="3"
                                                              ItemsSource="{Binding DataContext.ComputeTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding ComputeType, Mode=TwoWay}"
                                                              Style="{StaticResource FormComboBoxStyle}" />
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                    <Button Content="ذخیره"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Command="{Binding SaveCommand}"
                                                            Padding="16,6"
                                                            Margin="0,0,8,0" />
                                                    <Button Content="انصراف"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding CancelCommand}"
                                                            Padding="16,6" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="پرووایدرهای رایگان پیشنهادی"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="این پرووایدرها پلان رایگان دارند و می‌توانید به سرعت اضافه کنید:"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,10" />
                        <TextBlock Text="Groq — Whisper Large-v3-Turbo (رایگان، حدود ۸ ساعت در روز، بسیار سریع)" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2" />
                        <TextBlock Text="NVIDIA NIM — Whisper Large-v3 (پلان رایگان برای توسعه)" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2" />
                        <TextBlock Text="OpenRouter — دسترسی به مدل‌های رایگان متعدد" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2" />
                        <TextBlock Text="Together AI — Whisper با دایاریزیشن داخلی (پولی، ارزان)" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,2" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
