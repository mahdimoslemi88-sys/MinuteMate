# ==========================================================
# MinuteMate - فایل تنظیمات محیطی (خام)
# ==========================================================
# این فایل با نصب برنامه در کنار MinuteMate قرار می‌گیرد.
# برای افزودن دستی پرووایدر، مقدارها را بعد از «=» پر کنید و
# برنامه را دوباره اجرا کنید. هیچ کلیدی به‌صورت پیش‌فرض داخل
# این فایل نیست.
#
# محل‌های خوانده‌شده به ترتیب:
#   %MINUTEMATE_ENV_FILE%  ->  <پوشهٔ موتور>\.env  ->  <پوشهٔ برنامه>\.env
#   ->  <پوشهٔ جاری>\.env  ->  %LOCALAPPDATA%\MinuteMate\.env
# ==========================================================

# ---------- پرووایدرهای رونویسی (ASR) ----------

# Groq (رایگان): کلیدها را از https://console.groq.com/keys بگیرید.
# چند کلید را با کاما جدا کنید تا بین سهمیه‌ها چرخشی استفاده شود.
GROQ_API_KEY=

# ---------- مدل‌های محلی ----------

# مسیر پوشهٔ مدل‌ها (در صورت خالی بودن، کنار برنامه/کاربر جست‌وجو می‌شود)
# MINUTEMATE_MODELS_DIR=

# مدل پیش‌فرض رونویسی محلی: turbo | fa
# MINUTEMATE_DEFAULT_ASR_MODEL=turbo

# ---------- سخت‌افزار ----------

# auto | cuda | cpu
# MINUTEMATE_DEVICE=auto

# auto | float16 | int8 | int8_float16
# MINUTEMATE_COMPUTE_TYPE=auto

# MINUTEMATE_NUM_THREADS=6
# MINUTEMATE_BATCH_SIZE=0

# ---------- FFmpeg ----------

# مسیر ffmpeg.exe (در صورت خالی بودن از PATH استفاده می‌شود)
# MINUTEMATE_FFMPEG_PATH=ffmpeg

# ---------- تفکیک گویندگان ----------

# wespeaker | 3dspeaker
# MINUTEMATE_SPEAKER_EMBEDDING=wespeaker

# 0 = تخمین خودکار
# MINUTEMATE_NUM_SPEAKERS=4

# ---------- صورت‌جلسه (LLM اختیاری) ----------

# MINUTEMATE_MINUTES_ENABLED=false
# MINUTEMATE_MINUTES_PROVIDER=openai-compatible
# MINUTEMATE_MINUTES_BASE_URL=https://api.openai.com/v1
# MINUTEMATE_MINUTES_MODEL=gpt-4o-mini
# MINUTEMATE_MINUTES_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=

# ---------- لاگ ----------

# DEBUG | INFO | WARNING | ERROR
# MINUTEMATE_LOG_LEVEL=INFO
