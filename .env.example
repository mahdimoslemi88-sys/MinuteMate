# MinuteMate Environment Configuration
# کپی کنید به .env و مقادیر را پر کنید
# cp .env.example .env

# ==========================================
# ASR Providers (API Keys)
# ==========================================

# Groq - رایگان، سریع، 8 ساعت/روز (whisper-large-v3-turbo)
# ثبت‌نام: https://console.groq.com/keys
# چند کلید را با کاما جدا کنید برای load balancing بین rate limits
GROQ_API_KEY=

# Google Cloud Speech (Chromium endpoint) - رایگان عمومی، محدود
# در کدhardcoded است، نیاز به کلید ندارد
# GOOGLE_SPEECH_ENABLED=true

# ==========================================
# Local Models Configuration
# ==========================================

# دایرکتوری مدل‌ها (پیش‌فرض: models/ در ریشه پروژه)
# MINUTEMATE_MODELS_DIR=C:\Users\LENOVO LOQ\Desktop\projects\Minute-mate\models

# پیش‌فرض مدل محلی: turbo | fa | whisper-fa
# MINUTEMATE_DEFAULT_ASR_MODEL=turbo

# ==========================================
# Hardware / Performance
# ==========================================

# دستگاه: auto | cuda | cpu
# MINUTEMATE_DEVICE=auto

# محاسبه: auto | float16 | int8 | int8_float16
# MINUTEMATE_COMPUTE_TYPE=auto

# تعداد تردها برای CPU
# MINUTEMATE_NUM_THREADS=6

# Batch size برای GPU (0 = غیرفعال، پیشنهادی 4-16)
# MINUTEMATE_BATCH_SIZE=0

# ==========================================
# Audio Processing
# ==========================================

# مسیر FFmpeg (اگر در PATH نیست)
# MINUTEMATE_FFMPEG_PATH=ffmpeg

# پیش‌پردازش صدا (true/false) - اگر false فقط highpass=60 اعمال می‌شود
# MINUTEMATE_PREPROCESS_ENABLED=true

# ==========================================
# Diarization
# ==========================================

# مدل embedding گوینده: wespeaker | 3dspeaker
# MINUTEMATE_SPEAKER_EMBEDDING=wespeaker

# تعداد گویندگان پیش‌فرض (0 = تشخیص خودکار)
# MINUTEMATE_NUM_SPEAKERS=4

# ==========================================
# Output / Sessions
# ==========================================

# ریشه ذخیره جلسات
# MINUTEMATE_SESSIONS_ROOT=C:\Users\LENOVO LOQ\AppData\Local\MinuteMate\sessions

# دایرکتوری لاگ‌ها
# MINUTEMATE_LOG_DIR=C:\Users\LENOVO LOQ\AppData\Local\MinuteMate\logs

# ==========================================
# Minutes Generation (LLM)
# ==========================================

# فعال‌سازی تولید صورت‌جلسه
# MINUTEMATE_MINUTES_ENABLED=false

# Provider: openai-compatible | ollama
# MINUTEMATE_MINUTES_PROVIDER=openai-compatible

# Base URL برای OpenAI-compatible
# MINUTEMATE_MINUTES_BASE_URL=https://api.openai.com/v1

# نام مدل LLM
# MINUTEMATE_MINUTES_MODEL=gpt-4o-mini

# Environment variable نام کلید API (امنیت: کلید در env است، نه در job)
# MINUTEMATE_MINUTES_API_KEY_ENV=OPENAI_API_KEY

# OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# ==========================================
# Logging
# ==========================================

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
# MINUTEMATE_LOG_LEVEL=INFO

# ==========================================
# Desktop App (WPF)
# ==========================================

# مسیرEjecutable موتور (sidecar) - اگر خالی auto-detect
# MINUTEMATE_ENGINE_EXECUTABLE=

# مسیر Python (اگر sidecar نیست)
# MINUTEMATE_PYTHON_PATH=